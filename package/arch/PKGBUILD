pkgname=nulla
pkgver=0.2.0
pkgrel=1
pkgdesc="Minimalist script and config editor"
arch=('x86_64' 'aarch64')
url="https://github.com/pzwt4cc/nulla"
license=('WTFPL')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg')
optdepends=('qt6-wayland: Wayland platform support')
makedepends=('gcc' 'make' 'pkgconf' 'cargo')

build() {
  cd "$startdir/../.."
  make
}

package() {
  cd "$startdir/../.."
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
